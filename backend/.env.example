PORT=8787
CORS_ORIGIN=http://localhost:3000

S3_ENDPOINT=http://minio.local:9000
S3_REGION=us-east-1
S3_BUCKET=party-album
S3_ACCESS_KEY_ID=replace-with-access-key
S3_SECRET_ACCESS_KEY=replace-with-secret-key
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRES_SECONDS=300

# 15 MB
UPLOAD_MAX_BYTES=15728640

# Local JSON store used in MVP before database integration
DATA_DIR=./data

# Event token enforcement. Keep token stable for the full event to avoid
# rewriting NFC tags while the event is active.
EVENT_TOKEN_REQUIRED=true
EVENT_DEFAULT_TOKEN=
EVENT_TOKENS_JSON={"sample-event":"replace-with-long-lived-event-token"}